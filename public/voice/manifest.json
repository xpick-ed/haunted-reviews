  "hash": "d17484559b1d"
 },
 "ayi.1": {
  "file": "ayi.1.mp3",
  "who": "ayi",
  "text": "嗝……喲，這不是阿春嬤嗎？妳也還沒走喔？",
  "dur": 5.16,
  "hash": "62682b002ae6"
 },
 "ayi.2": {
  "file": "ayi.2.mp3",
  "who": "grandma",
  "text": "阿義，你又喝了。",
  "dur": 2.33,
  "hash": "274e9eafc16d"
 },
 "ayi.3": {
  "file": "ayi.3.mp3",
  "who": "ayi",
  "text": "鬼喝酒不會醉啦……只是比較開心。嗝。",
  "dur": 4.8,
  "hash": "0e02055fb362"
 },
 "ayi.4": {
  "file": "ayi.4.mp3",
  "who": "ayi",
  "text": "聽說妳孫子開民宿？要不要我去幫忙嚇客人，嘿嘿。",
  "dur": 6.1,
  "hash": "2999ded43bfa"
 },
 "ayi.5a": {
  "file": "ayi.5a.mp3",
  "who": "ayi",
  "text": "好啦好啦……那給妳一個秘訣：客人醒著的時候，千萬不要碰被子。",
  "dur": 6.12,
  "hash": "d94faf725b53"
 },
 "ayi.5b": {
  "file": "ayi.5b.mp3",
  "who": "ayi",
  "text": "燈閃一閃、杯子動一動，那種拿相機的年輕人最愛了。",
  "dur": 6.0,
  "hash": "1750634636de"
 },
 "ayi.6b": {
  "file": "ayi.6b.mp3",
  "who": "ayi",
  "text": "不過妳這張慈祥的臉喔……嚇不到人啦，哈哈，嗝。",
  "dur": 4.97,
  "hash": "0a66d8ae03e8"
 },
 "ayi.7": {
  "file": "ayi.7.mp3",
  "who": "ayi",
  "text": "陰氣不夠的時候，來廟裡上個香，土地公會分妳一點。",
  "dur": 5.66,
  "hash": "d8d5a73ea730"
 },
 "ayi.a1": {
  "file": "ayi.a1.mp3",
  "who": "ayi",
  "text": "嗝……妳、妳也是新來的喔？",
  "dur": 2.83,
  "hash": "6693ebcbb63b"
 },
 "ayi.a2": {
  "file": "ayi.a2.mp3",
  "who": "ayi",
  "text": "再一杯就好……再一杯就好啦……",
  "dur": 2.86,
  "hash": "fef88738a451"
 },
 "ayi.again": {
  "file": "ayi.again.mp3",
  "who": "ayi",
  "text": "嗝……還沒天亮喔？再一瓶就好……",
  "dur": 3.82,
  "hash": "5172efb12322"
 },
 "ayi.how": {
  "file": "ayi.how.mp3",
  "who": "grandma",
  "text": "……你說說看，要怎麼嚇？",
  "dur": 3.1,
  "hash": "b862b7cba1be"
 },
 "ayi.no": {
  "file": "ayi.no.mp3",
  "who": "grandma",
  "text": "不要！我是要照顧客人的。",
  "dur": 4.27,
  "hash": "547654f37f93"
 },
 "chendong.a1": {
  "file": "chendong.a1.mp3",
  "who": "chendong",
  "text": "年輕人，這塊地的價錢，我可以開得很漂亮。",
  "dur": 3.79,
  "hash": "119f6b8940ea"
 },
 "chendong.a2": {
  "file": "chendong.a2.mp3",
  "who": "chendong",
  "text": "哎呀，我只是來住一晚，看看風景而已。",
  "dur": 3.62,
  "hash": "69bf65ee98af"
 },
