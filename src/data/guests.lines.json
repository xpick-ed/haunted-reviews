  "gm.chat.2": {
    "who": "grandma",
    "text": "好久不見了。"
  },
  "gm.seen.1": {
    "who": "grandma",
    "text": "唉呀，被看到了……"
  },
  "gm.seen.2": {
    "who": "grandma",
    "text": "歹勢歹勢，嚇到你了。"
  },
  "gm.nearmiss.1": {
    "who": "grandma",
