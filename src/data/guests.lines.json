  },
  "gm.nearmiss.2": {
    "who": "grandma",
    "text": "差一點點。"
  },
  "gm.carry.1": {
    "who": "grandma",
    "text": "端穩端穩，別灑出來。"
  },
  "gm.carry.2": {
    "who": "grandma",
    "text": "宵夜來了，慢慢走。"
  },
  "gm.noyin.1": {
    "who": "grandma",
    "text": "陰氣不夠了……"
  },
  "gm.noyin.2": {
    "who": "grandma",
    "text": "阿嬤有點累了……"
  },
  "gm.freeze.1": {
    "who": "grandma",
    "text": "一、二、三……木頭人。"
  },
  "gm.freeze.2": {
    "who": "grandma",
    "text": "不要動、不要動……"
  },
  "gm.captured.1": {
    "who": "grandma",
    "text": "阿嬤這樣上鏡嗎？"
  },
  "gm.captured.2": {
    "who": "grandma",
    "text": "要拍就拍好看一點啦。"
  },
  "miaogong.arrive.1": {
