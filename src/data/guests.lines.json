  "gm.tuck.1": {
    "who": "grandma",
    "text": "被子拉好，才不會著涼。"
  },
  "gm.tuck.2": {
    "who": "grandma",
    "text": "乖乖睡，阿嬤在這裡。"
  },
  "gm.temp.1": {
    "who": "grandma",
    "text": "電風扇轉一下，涼涼的。"
  },
  "gm.temp.2": {
    "who": "grandma",
    "text": "這樣比較好睡。"
  },
  "gm.water.1": {
    "who": "grandma",
    "text": "半夜口渴，水放這裡喔。"
  },
  "gm.water.2": {
    "who": "grandma",
    "text": "喝點溫水，才不會咳嗽。"
  },
  "gm.coil.1": {
    "who": "grandma",
    "text": "點個蚊香，蚊子走開。"
  },
  "gm.coil.2": {
    "who": "grandma",
    "text": "阿嬤幫你把蚊子趕走。"
  },
  "gm.nightlight.1": {
    "who": "grandma",
    "text": "留一盞小燈，就不怕黑了。"
  },
  "gm.nightlight.2": {
    "who": "grandma",
    "text": "燈開著，阿嬤陪你。"
  },
  "gm.cook.1": {
    "who": "grandma",
    "text": "來煎個菜脯蛋！"
  },
  "gm.cook.2": {
    "who": "grandma",
    "text": "阿嬤的拿手菜，馬上好。"
  },
  "gm.deliver.1": {
    "who": "grandma",
    "text": "宵夜來囉，趁熱吃。"
  },
  "gm.deliver.2": {
    "who": "grandma",
    "text": "吃飽才睡得好。"
  },
  "gm.pat.1": {
    "who": "grandma",
    "text": "拍拍，睡喔睡喔。"
  },
  "gm.pat.2": {
    "who": "grandma",
    "text": "秀秀，沒事沒事。"
  },
  "gm.lullaby.1": {
    "who": "grandma",
    "text": "嬰仔嬰嬰睏，一暝大一寸～"
  },
  "gm.lullaby.2": {
    "who": "grandma",
    "text": "嗯～嗯嗯～搖啊搖～"
  },
  "gm.window.1": {
    "who": "grandma",
    "text": "風這麼大，窗關起來。"
  },
  "gm.window.2": {
    "who": "grandma",
    "text": "夜裡涼，關窗關窗。"
  },
  "gm.flicker.1": {
    "who": "grandma",
    "text": "燈閃一下下就好。"
  },
  "gm.flicker.2": {
    "who": "grandma",
    "text": "這樣……算嚇人嗎？"
  },
  "gm.rocker.1": {
    "who": "grandma",
    "text": "搖椅借阿嬤坐一下。"
  },
  "gm.rocker.2": {
    "who": "grandma",
    "text": "以前阿公最愛坐這張。"
  },
  "gm.knock.1": {
    "who": "grandma",
    "text": "叩叩，有人在嗎？"
  },
  "gm.knock.2": {
    "who": "grandma",
    "text": "阿嬤只是敲個門……"
  },
  "gm.mirror.1": {
    "who": "grandma",
    "text": "鏡子裡的阿嬤，漂不漂亮？"
  },
  "gm.mirror.2": {
    "who": "grandma",
    "text": "嘿，看這裡～"
  },
  "gm.play.1": {
    "who": "grandma",
    "text": "好，陪你玩一下下。"
  },
  "gm.play.2": {
    "who": "grandma",
    "text": "來，阿嬤跟你玩。"
  },
  "gm.chat.1": {
    "who": "grandma",
    "text": "老朋友，來開講一下。"
