  "han.broke.1": {
    "who": "xiaohan",
    "text": "這個月又虧錢了……怎麼辦。"
  },
  "han.broke.2": {
    "who": "xiaohan",
    "text": "再這樣下去，房子可能保不住。"
  },
  "han.good.1": {
    "who": "xiaohan",
    "text": "這個月評價好好！阿嬤，妳看到了嗎？"
  },
  "han.good.2": {
    "who": "xiaohan",
    "text": "客人都說睡得很好，好奇怪喔。"
  },
  "dlg.xiaoyu.1": {
    "who": "xiaoyu",
    "text": "阿嬤！我們來玩一二三木頭人！"
  },
  "dlg.xiaoyu.2": {
    "who": "grandma",
    "text": "好啊，小聲一點，媽媽在睡覺。"
  },
  "dlg.xiaoyu.3": {
    "who": "xiaoyu",
    "text": "一、二、三……木頭人！阿嬤不能動！"
  },
  "dlg.xiaoyu.4": {
    "who": "grandma",
    "text": "阿嬤最會當木頭人了，站一整晚都不累。"
  },
  "dlg.xiaoyu.5": {
    "who": "xiaoyu",
    "text": "哈哈，阿嬤妳的腳在飄耶！"
  },
  "dlg.xiaoyu.6": {
    "who": "grandma",
    "text": "噓——這是阿嬤跟你的祕密喔。"
  },
  "dlg.xiaoyu.7": {
    "who": "xiaoyu",
    "text": "好！打勾勾！阿嬤晚安！"
  },
  "dlg.agui.1": {
    "who": "agui",
    "text": "阿春，我就知道妳還在。"
  },
  "dlg.agui.2": {
    "who": "grandma",
    "text": "阿桂，妳還是那麼大聲。"
  },
  "dlg.agui.3": {
    "who": "atu",
    "text": "……灶腳的菜脯蛋味，是妳吧。"
  },
  "dlg.agui.4": {
    "who": "agui",
    "text": "妳孫子很乖喔，一個人撐這間厝。"
  },
  "dlg.agui.5": {
    "who": "grandma",
    "text": "就是太乖了，阿嬤才放不下心。"
  },
  "dlg.agui.6": {
    "who": "atu",
    "text": "……妳在等什麼？"
  },
  "dlg.agui.7": {
    "who": "grandma",
    "text": "等他哪一天笑著說：阿嬤，我可以了。"
  },
  "dlg.agui.8": {
    "who": "agui",
    "text": "憨人，那妳就慢慢等，我們陪妳。"
  }
}
